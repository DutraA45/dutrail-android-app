<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. A sessão é cifrada com uma chave do Keystore que não vai para o backup nem para outro aparelho. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/session.pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/session.pb" />
    </device-transfer>
</data-extraction-rules>
